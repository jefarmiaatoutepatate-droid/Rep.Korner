{
  "expo": {
    "name": "FitCoach",
    "slug": "fitcoach",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fitcoach",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B2545",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2545"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitcoach.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitcoach.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2545"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#E85D04"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitCoach accède à tes photos pour illustrer ton suivi de progression.",
          "cameraPermission": "FitCoach utilise l'appareil photo pour tes photos avant/après."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "claudeProxyUrl": "https://YOUR-WORKER.workers.dev"
    }
  }
}
