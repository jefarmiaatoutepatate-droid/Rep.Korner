# Copiez ce fichier en ".env" et remplissez vos propres valeurs.
# Ne committez JAMAIS le fichier ".env" (il est ignoré par .gitignore).

# Token du bot — Discord Developer Portal > votre application > Bot > Reset Token
DISCORD_TOKEN=

# Application ID — Discord Developer Portal > votre application > General Information > Application ID
DISCORD_CLIENT_ID=

# ID du serveur Discord où déployer les commandes en mode "rapide" (dev).
# Laissez vide pour déployer les commandes globalement (propagation ~1h, tous serveurs).
DISCORD_GUILD_ID=
